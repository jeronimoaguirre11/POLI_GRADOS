# Copia este archivo como k8s/secretos.env (esta en .gitignore) y cambia los
# valores. Kubernetes los guarda en el Secret "poli-grados-secretos".
#
# Claves largas y aleatorias:  openssl rand -hex 32
# DB_PASSWORD: usa solo letras y numeros (va dentro de la URL de conexion).

DB_USER=admin
DB_PASSWORD=admin123

JWT_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria
INTERNAL_API_KEY=cambia-esto-por-otra-clave-larga-y-aleatoria

# Super administrador unico (se crea al arrancar auth-service si no existe).
# Contrasena: 8-15 caracteres, una mayuscula y un numero.
SUPERADMIN_NOMBRE=Super administrador
SUPERADMIN_EMAIL=admin@elpoli.edu.co
SUPERADMIN_PASSWORD=Admin12345
