# Copia este archivo a .env y ajusta si cambias las credenciales del docker-compose
PORT=3001
DATABASE_URL="postgresql://admin:admin123@localhost:5433/auth_db?schema=public"

# Debe ser IGUAL en todos los microservicios que firman o validan JWT.
JWT_SECRET="cambia-esto-por-una-clave-larga-y-aleatoria"

# Clave compartida para las rutas /internal/* (llamadas entre microservicios,
# nunca las usa el gateway ni el frontend). Debe ser IGUAL en los servicios.
INTERNAL_API_KEY="cambia-esto-por-otra-clave-larga-y-aleatoria"

# URLs de los otros microservicios que auth-service necesita llamar al
# registrar una cuenta nueva (crear el perfil de Empresa o Estudiante).
EMPRESAS_SERVICE_URL="http://localhost:3002"
ESTUDIANTES_SERVICE_URL="http://localhost:3003"
