PORT=3009

# Debe ser el mismo JWT_SECRET de auth-service: este servicio valida los
# tokens emitidos al iniciar sesion.
JWT_SECRET="cambia-esto-por-una-clave-larga-y-aleatoria"

# Debe coincidir con INTERNAL_API_KEY de auth-service.
INTERNAL_API_KEY="cambia-esto-por-otra-clave-larga-y-aleatoria"

# Unico servicio que se llama directamente. auth-service se encarga de crear
# los perfiles en empresas, estudiantes y docentes.
AUTH_SERVICE_URL="http://localhost:3001"
