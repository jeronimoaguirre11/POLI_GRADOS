PORT=3009

# Debe ser el mismo JWT_SECRET de auth-service: este servicio valida los
# tokens emitidos al iniciar sesion.
JWT_SECRET="cambia-esto-por-una-clave-larga-y-aleatoria"

# Debe coincidir con INTERNAL_API_KEY de auth-service.
INTERNAL_API_KEY="cambia-esto-por-otra-clave-larga-y-aleatoria"

# auth-service crea las cuentas (y sus perfiles al registrarlas).
AUTH_SERVICE_URL="http://localhost:3001"

# Para ver y editar el perfil de cada cuenta segun su rol.
EMPRESAS_SERVICE_URL="http://localhost:3002"
ESTUDIANTES_SERVICE_URL="http://localhost:3003"
DOCENTES_SERVICE_URL="http://localhost:3008"
