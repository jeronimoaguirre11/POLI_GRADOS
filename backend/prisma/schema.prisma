// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  ESTUDIANTE
  EMPRESA
  COORDINADOR
  DOCENTE
}

model Coordinador {
  id        String  @id @default(uuid())
  usuarioId String  @unique
  usuario   Usuario @relation(fields: [usuarioId], references: [id])
  cargo     String?

  procesosAsignados ProcesoGrado[]
}

enum Modalidad {
  INVESTIGACION
  DIPLOMADO
  PRACTICA
}

enum TipoDocente {
  DOCENTE
  EGRESADO
}

enum TipoPractica {
  UNIVERSIDAD
  INDEPENDIENTE
}

model Usuario {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  nombre    String
  rol       Rol
  createdAt DateTime @default(now())

  estudiante  Estudiante?
  empresa     Empresa?
  docente     Docente?
  coordinador Coordinador?
}

model Estudiante {
  id        String  @id @default(uuid())
  usuarioId String  @unique
  usuario   Usuario @relation(fields: [usuarioId], references: [id])
  codigo    String  @unique
  programa  String
  semestre  Int?

  procesoGrado  ProcesoGrado?
  postulaciones Postulacion[]
}

model Empresa {
  id            String  @id @default(uuid())
  usuarioId     String  @unique
  usuario       Usuario @relation(fields: [usuarioId], references: [id])
  nombreEmpresa String
  nit           String  @unique
  sector        String

  ofertas Oferta[]
}

model Docente {
  id           String      @id @default(uuid())
  usuarioId    String      @unique
  usuario      Usuario     @relation(fields: [usuarioId], references: [id])
  tipo         TipoDocente
  especialidad String

  procesosAsesorados ProcesoGrado[]
}

model ProcesoGrado {
  id              String       @id @default(uuid())
  estudianteId    String       @unique
  estudiante      Estudiante   @relation(fields: [estudianteId], references: [id])
  modalidad       Modalidad
  estado          String       @default("EN_PROCESO")
  asesorId        String?
  asesor          Docente?     @relation(fields: [asesorId], references: [id])
  coordinadorId   String?
  coordinador     Coordinador? @relation(fields: [coordinadorId], references: [id])
  fechaAsignacion DateTime?
  fechaInicio     DateTime     @default(now())

  investigacion Investigacion?
  diplomado     Diplomado?
  practica      Practica?
}

model Investigacion {
  id                 String       @id @default(uuid())
  procesoGradoId     String       @unique
  procesoGrado       ProcesoGrado @relation(fields: [procesoGradoId], references: [id])
  grupoInvestigacion String
  ideaPropuesta      String
  materiaMatriculada Boolean      @default(false)
}

model Diplomado {
  id               String       @id @default(uuid())
  procesoGradoId   String       @unique
  procesoGrado     ProcesoGrado @relation(fields: [procesoGradoId], references: [id])
  nombreCurso      String
  institucion      String
  estadoAprobacion String       @default("PENDIENTE")
}

model Practica {
  id               String       @id @default(uuid())
  procesoGradoId   String       @unique
  procesoGrado     ProcesoGrado @relation(fields: [procesoGradoId], references: [id])
  tipo             TipoPractica
  horasCompletadas Int          @default(0)
  ofertaId         String?
  oferta           Oferta?      @relation(fields: [ofertaId], references: [id])
  estadoReporte    String       @default("PENDIENTE")
}

enum PerfilBuscado {
  TECNOLOGIA_AGROPECUARIA
  ADMINISTRACION_EMPRESAS_AGROPECUARIAS
  INGENIERO_AGROPECUARIO
}

enum ModalidadContratacion {
  CONTRATO_SENA
  CONVENIO
  VOLUNTARIA
}

model Oferta {
  id                      String                @id @default(uuid())
  empresaId               String
  empresa                 Empresa               @relation(fields: [empresaId], references: [id])
  titulo                  String
  descripcion             String
  perfilBuscado           PerfilBuscado
  modalidadContratacion   ModalidadContratacion
  ubicacion               String
  funciones               String
  fechaInicioConvocatoria DateTime
  fechaFinConvocatoria    DateTime
  fechaInicioPractica     DateTime
  duracionMeses           Int
  imagenUrl               String?
  estado                  String                @default("ABIERTA")
  fechaPublicacion        DateTime              @default(now())

  postulaciones Postulacion[]
  practicas     Practica[]
}

model Postulacion {
  id                   String     @id @default(uuid())
  ofertaId             String
  oferta               Oferta     @relation(fields: [ofertaId], references: [id])
  estudianteId         String
  estudiante           Estudiante @relation(fields: [estudianteId], references: [id])
  hojaVidaUrl           String
  estado               String     @default("PENDIENTE")
  observacionesEmpresa String?
  fecha                 DateTime   @default(now())
  updatedAt             DateTime   @default(now()) @updatedAt

  // Un estudiante no puede postularse dos veces a la misma convocatoria.
  @@unique([ofertaId, estudianteId])
}
